<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
    <title>Verify Checkout</title>

</head>

<body>
    <div class="loader-box active">
        <!-- <div id="lottie-animation"></div> -->
        <dotlottie-player src="https://lottie.host/edbb15de-67a6-40f2-95c7-151399e8da83/mgrvnR3nWt.lottie"
            background="transparent" speed="1" style="width: 300px; height: 300px" loop autoplay></dotlottie-player>
    </div>
    <div class="content-wrapper">
        <!-- From Uiverse.io by ZstarPanda0210 -->

        <div class="card-success {{#if verified}}active{{/if}}">
            <button type="button" class="dismiss-success">×</button>
            <div class="header-success">
                <div class="image-success">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                        <g stroke-width="0" id="SVGRepo_bgCarrier"></g>
                        <g stroke-linejoin="round" stroke-linecap="round" id="SVGRepo_tracerCarrier"></g>
                        <g id="SVGRepo_iconCarrier">
                            <path stroke-linejoin="round" stroke-linecap="round" stroke-width="1.5" stroke="#000000"
                                d="M20 7L9.00004 18L3.99994 13"></path>
                        </g>
                    </svg>
                </div>
                <div class="content-success">
                    <span class="title-success">{{message}}</span>
                    <p class="message-success">{{content}}</p>
                </div>
                <div class="actions-success">
                    <button type="button" class="history-success">Go to dashboard</button>
                    <button type="button" class="track-success">Track my package</button>
                </div>
            </div>
        </div>

        <!-- From Uiverse.io by Yaya12085 -->
        <div class="card {{#if verified}}{{else}}active{{/if}}">
            <div class="header">
                <div class="image">
                    <svg aria-hidden="true" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" fill="none">
                        <path
                            d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"
                            stroke-linejoin="round" stroke-linecap="round"></path>
                    </svg>
                </div>
                <div class="content">
                    <span class="title">{{message}}</span>
                    <p class="message">
                        {{content}}
                    </p>
                </div>
                <div class="actions">
                    <button class="desactivate" type="button">Back to Checkout</button>
                    <button class="cancel" type="button">Close</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://unpkg.com/@dotlottie/player-component@2.7.12/dist/dotlottie-player.mjs" type="module"></script>

    <script>
        window.addEventListener("load", () => {
            setTimeout(() => {
                document.querySelector(".loader-box").style.display = "none";
            })
        })
    </script>

</body>

</html>